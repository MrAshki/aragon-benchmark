# GEMINI_API_KEY: Required for real Gemini 4 Argon / Gemini 3.8 Flash API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JEV_API_KEY: OpenRouter API key (Bearer token) for TypeSafe Jev (typesafe/jev-1.14) via OpenRouter Decisions API.
# When omitted, Jev Router runs in deterministic calibrated demo mode.
JEV_API_KEY=""

# JEV_API_URL: OpenRouter Decisions API endpoint for typesafe/jev-1.14.
JEV_API_URL="https://openrouter.ai/api/alpha/decisions"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
